        }
      ]
    },
    {
      "name": "me rejects POST",
      "endpoint": "me",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/me",
            "headers": { "content-type": "application/json" },
            "json": {}
          },
          "response": { "status": 405, "json": { "error": "method_not_allowed" } }
        }
      ]
    },
    {
      "name": "logout rejects GET",
      "endpoint": "logout",
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/auth/logout" },
          "response": { "status": 405, "json": { "error": "method_not_allowed" } }
